# Copy the secrets below into a local .env.local (gitignored) — never put
# secrets in .env, which is committed to this repo.

# Public — already present in the tracked .env, shown here for reference.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# APP_SUPABASE_URL=
# APP_SUPABASE_PUBLISHABLE_KEY=
# APP_PUBLIC_SUPABASE_URL=
# APP_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Lovable Cloud reserves SUPABASE_ secret names, so use this server-only alias.
# APP_SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_APP_SUPABASE_URL=
# VITE_APP_SUPABASE_PUBLISHABLE_KEY=

# Shipping policy — orders below this threshold pay this shipping fee.
VITE_FREE_SHIPPING_THRESHOLD=200
VITE_SHIPPING_FEE=50

# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_SECRET is a secret: server-only, never expose to the client.
RAZORPAY_KEY_ID=rzp_test_eR5i8vZrGKVnEB
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=rzp_test_eR5i8vZrGKVnEB

# Canonical production URL. Used so auth emails (signup confirmation, password
# reset) always link back to the real site instead of whatever origin the
# browser happened to be on (e.g. localhost during local development). Must
# also be added to Supabase Dashboard → Authentication → URL Configuration →
# Site URL / Redirect URLs, or Supabase will ignore it and use its own
# fallback regardless of what the app sends.
VITE_SITE_URL=https://md-attire.lovable.app
